rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidProject(data) {
      return data.name is string && data.name.size() <= 200 &&
             data.project is string && data.project.size() <= 300 &&
             data.price is number && data.price >= 0 &&
             data.status is string && data.status.size() <= 100;
    }

    match /projects/{projectId} {
      allow read: if true;
      allow create, update: if isValidProject(request.resource.data);
      allow delete: if true;
    }

    match /settings/{settingId} {
      allow read, write: if true;
    }

    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
